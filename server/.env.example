PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI= ""

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google OAuth (optional - leave blank to disable "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for storing users' own Gemini API keys (32-byte hex string)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_byte_hex_string

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Rate limiting for users on the shared key
FREE_TIER_DAILY_AI_LIMIT=10

# CORS
CLIENT_URL=http://localhost:5173
